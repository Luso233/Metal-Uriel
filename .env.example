# ==========================================================
# :UNID • Metal-Uriel v2.0 (Plug & Play)
# Plantilla Virgen de Variables de Entorno (.env.example)
# ==========================================================
# INSTRUCCIONES:
#   NO necesitas llenar este archivo a mano si usas el Asistente Web.
#   Al ejecutar `npm start` (o `iniciar-metal-uriel.bat`), Metal-Uriel
#   detecta que es una instalación virgen y abre automáticamente el
#   Asistente de Configuración en http://localhost:3000 para validar
#   todas tus API Keys, crear MariaDB y generar el .env real.
# ==========================================================

# Bandera de instalación virgen (el Asistente Web la cambia a true)
SETUP_COMPLETED=false
NODE_ENV=production

# Red: 0.0.0.0 permite que las PCs de Admisiones accedan por IP LAN
HOST=0.0.0.0
PORT=3000
PRIMARY_CAMPUS=campeche

# ==========================================================
# 1. Base de Datos MariaDB (se auto-crea con sus 8 tablas)
# ==========================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unid_admisiones

# ==========================================================
# 2. Proveedores de Inteligencia Artificial (Cascada Inteligente)
# Reglas de formato validadas automáticamente:
#   - GEMINI_API_KEY:    Inicia con "AIza" (35–55 chars)
#   - ANTHROPIC_API_KEY: Inicia con "sk-ant-" (40–180 chars)
#   - OPENAI_API_KEY:    Inicia con "sk-" o "sk-proj-" (32–220 chars)
#   - DEEPSEEK_API_KEY:  Inicia con "sk-" (24–120 chars)
#   - GROQ_API_KEY:      Inicia con "gsk_" (40–120 chars)
# ==========================================================
DEFAULT_AI_MODEL=auto-fallback
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ==========================================================
# 3. Ollama Local (Último Recurso Opcional en Cascada)
# Desactivado por defecto para no saturar PCs con <= 8 GB RAM.
# Activar SOLO si verificaste >= 4 GB RAM libre con todo corriendo.
# ==========================================================
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=15000

# ==========================================================
# 4. Meta WhatsApp Cloud API (Meta Developers)
# Reglas de formato validadas automáticamente:
#   - WHATSAPP_PHONE_NUMBER_ID: SOLO NÚMEROS (10–20 dígitos)
#   - WHATSAPP_TOKEN:           Inicia con "EAA" (80–500 chars alfanuméricos)
#   - META_VERIFY_TOKEN:        8–128 chars (letras, números, _ o -)
#   - META_APP_SECRET:          32 chars hexadecimales (opcional; activa HMAC X-Hub-Signature-256)
# ==========================================================
META_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# ==========================================================
# 5. Seguridad, Sesiones JWT y Bóveda AES-256-GCM
# El Asistente genera automáticamente llaves criptográficas de 256 bits.
# ==========================================================
JWT_SECRET=
ENCRYPTION_MASTER_KEY=

# ==========================================================
# 6. Correo SMTP y Alertas Críticas ("Life Support")
# ALERT_ADMIN_EMAIL recibe avisos automáticos si falla la IA o MariaDB.
# ==========================================================
ADMISSIONS_NOTIFICATION_EMAIL=
ALERT_ADMIN_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ==========================================================
# 7. Observabilidad LLM Opcional (Langfuse Self-Hosted / Cloud)
# Deja vacío si solo deseas usar la telemetría local en MariaDB (llm_telemetria).
# ==========================================================
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
