# ==========================================
# :UNID • Metal-Uriel Admissions Bot
# Variables de Entorno y Configuración
# ==========================================

# Puerto del Servidor
PORT=3000

# Meta WhatsApp Cloud API (Meta Developers)
META_VERIFY_TOKEN=mi_token_secreto_123
WHATSAPP_TOKEN=tu_token_de_whatsapp_business_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# ==========================================
# Proveedores de Inteligencia Artificial (LLMs)
# El sistema cuenta con Cascada Inteligente (Auto-Fallback).
# Si un modelo no tiene API Key, se ocultará automáticamente del selector.
# ==========================================

# 1. Google Gemini (Recomendado / Principal)
GEMINI_API_KEY=tu_api_key_de_gemini

# 2. Anthropic Claude (Claude 3.5 Haiku / Sonnet)
ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui

# 3. OpenAI (GPT-4o-mini / GPT-4o)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# 4. DeepSeek (DeepSeek-V3 Chat)
DEEPSEEK_API_KEY=tu_api_key_de_deepseek_aqui

# 5. Groq Cloud (Llama 3.3 70B Ultra Fast)
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Modelo Predeterminado ('auto-fallback' recomendado para alta disponibilidad)
DEFAULT_AI_MODEL=auto-fallback

# ==========================================
# Base de Datos MariaDB Local
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_de_mariadb
DB_NAME=unid_admisiones

# ==========================================
# Seguridad y Autenticación del Panel Web
# ==========================================
JWT_SECRET=unid_metal_uriel_jwt_secret_key_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=unid2026

# ==========================================
# Notificaciones por Correo Electrónico (Opcional)
# ==========================================
ADMISSIONS_NOTIFICATION_EMAIL=admisiones.campeche@unid.mx
SMTP_HOST=smtp.gmail.com
