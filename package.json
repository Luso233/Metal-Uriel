{
  "name": "metal-uriel-bot",
  "version": "2.0.0",
  "description": "Centro de Mando Plug & Play y Asistente Inteligente de Admisiones UNID con Setup Wizard, WhatsApp Cloud API, Cascada Multi-LLM (Gemini 3.8 Flash, Claude, OpenAI, Groq, DeepSeek + Ollama opcional), MariaDB y React 18",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "prod": "pm2 start ecosystem.config.cjs",
    "prod:logs": "pm2 logs metal-uriel",
    "prod:restart": "pm2 restart metal-uriel",
    "prod:stop": "pm2 stop metal-uriel",
    "check": "node --check index.js && node --check lib/setup-utils.js"
  },
  "keywords": [
    "unid",
    "whatsapp-cloud-api",
    "google-gemini",
    "gemini-3.8-flash",
    "anthropic-claude",
    "openai",
    "ollama",
    "mariadb",
    "express",
    "react",
    "tailwind-css",
    "admissions-bot",
    "chatbot",
    "plug-and-play"
  ],
  "author": "Luis Felipe Quintero Cervera",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@google/genai": "^2.23.0",
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.0.10",
    "openai": "^4.63.0"
  }
}
