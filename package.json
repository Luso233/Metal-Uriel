{
  "name": "metal-uriel-bot",
  "version": "3.0.0-modular",
  "description": "Centro de Mando Modular (src/ + Vite React 18 + Tailwind local offline) y Asistente Inteligente de Admisiones UNID con Setup Wizard, WhatsApp Cloud API, Cascada Multi-LLM y MariaDB",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:headless": "node headless.js",
    "dev": "node --watch index.js",
    "dev:client": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "prod": "pm2 start ecosystem.config.cjs --only metal-uriel",
    "prod:headless": "pm2 start ecosystem.config.cjs --only metal-uriel-headless",
    "prod:logs": "pm2 logs metal-uriel",
    "prod:restart": "pm2 restart metal-uriel",
    "prod:stop": "pm2 stop metal-uriel",
    "check": "node -e \"const fs=require('fs'),p=require('path'),cp=require('child_process');const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(p.join(d,e.name)):e.name.endsWith('.js')?[p.join(d,e.name)]:[]);['index.js','headless.js',...walk('lib'),...walk('src')].forEach(f=>{const r=cp.spawnSync(process.execPath,['--check',f],{stdio:'inherit'});if(r.status!==0)process.exit(1);});console.log('ALL_JS_OK');\"",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "unid",
    "whatsapp-cloud-api",
    "google-gemini",
    "gemini-3.8-flash",
    "anthropic-claude",
    "openai",
    "ollama",
    "mariadb",
    "express",
    "react",
    "tailwind-css",
    "admissions-bot",
    "chatbot",
    "plug-and-play"
  ],
  "author": "Luis Felipe Quintero Cervera",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.23.0",
    "@ngrok/ngrok": "^1.7.0",
    "axios": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jsqr": "^1.4.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.0.10",
    "openai": "^4.63.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "chart.js": "^4.4.7",
    "lucide": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  }
}
